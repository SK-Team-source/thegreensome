# Public site URL — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://thegreensome.com

# Image source: leave unset to load originals from thegreensome.com,
# or set to "local" after running `npm run images:download`.
# NEXT_PUBLIC_IMAGE_SOURCE=local

# Contact and wholesale forms send email through SMTP (server-side only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=info@thegreensome.com
